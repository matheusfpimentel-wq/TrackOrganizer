{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tracklistr",
  "version": "0.1.0",
  "identifier": "com.tracklistr.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tracklistr",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Tracklistr",
    "category": "Music",
    "shortDescription": "Organizador de metadados para biblioteca de DJ",
    "longDescription": "Tracklistr limpa, padroniza e cura metadados (ID3 tags) de uma biblioteca de DJ antes de carregar no Rekordbox, Serato, Traktor ou Ableton.",
    "copyright": "© 2026 Tracklistr",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
